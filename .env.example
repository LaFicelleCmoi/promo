# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou l'ancienne clé "anon"

# Clé secrète (server only) utilisée par /api/sync pour écrire les promos
SUPABASE_SECRET_KEY=sb_secret_xxx                         # ou l'ancienne clé "service_role"

# Protège /api/sync (Vercel Cron envoie automatiquement "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# URL publique du site (liens de confirmation d'email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails — option 1 (recommandée sans domaine) : SMTP Gmail, peut écrire à n'importe quelle adresse.
# Adresse Gmail dédiée + « mot de passe d'application » (myaccount.google.com/apppasswords, validation en 2 étapes requise).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=promotracker.alertes@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Emails — option 2 : Resend, clé API « Promo Tracker » (resend.com > API Keys).
# Utilisée seulement si SMTP_USER/SMTP_PASS sont vides.
RESEND_API_KEY=re_xxx
# Expéditeur. Avec Gmail : l'adresse Gmail elle-même, ex. "Promo Tracker <promotracker.alertes@gmail.com>".
# Avec Resend sans domaine vérifié, onboarding@resend.dev ne peut écrire qu'à l'adresse du compte Resend.
EMAIL_FROM=Promo Tracker <onboarding@resend.dev>
