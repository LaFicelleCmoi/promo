# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou l'ancienne clé "anon"

# Clé secrète (server only) utilisée par /api/sync pour écrire les promos
SUPABASE_SECRET_KEY=sb_secret_xxx                         # ou l'ancienne clé "service_role"

# Protège /api/sync (Vercel Cron envoie automatiquement "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me

# Inscription : par défaut le compte est créé déjà confirmé (aucun email requis).
# Mettre true pour exiger la confirmation par email (nécessite un envoi d'emails vers toutes les adresses).
REQUIRE_EMAIL_CONFIRMATION=false

# URL publique du site (liens de confirmation d'email)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifications système (Web Push) des promos de la wishlist.
# Clés à générer une fois : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BPxxx
VAPID_PRIVATE_KEY=xxx
VAPID_SUBJECT=https://promo-rouge.vercel.app
